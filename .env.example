# Copy to .env at the repo root - docker-compose reads it automatically to override the
# defaults baked into docker-compose.yml. Only needed for `docker compose up`; the backend's
# own `backend/.env` is for running it outside Docker.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production

# Bootstrap admin account created by seed.py on first run
ADMIN_EMAIL=admin@attendance.io
ADMIN_PASSWORD=change-this-too
