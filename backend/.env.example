# Copy to .env - read automatically by pydantic-settings.

# PostgreSQL connection string. Create the database first, e.g.:
#   createdb attendance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cosine similarity cutoff for Facenet512 matches - a configurable constant, not a magic number
# buried in code. Tune it using the confidence scores logged by POST /attendance/mark.
FACE_MATCH_THRESHOLD=0.6

# Bootstrap admin account created by `python -m app.seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-too

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
