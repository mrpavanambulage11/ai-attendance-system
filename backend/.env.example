# Copy this file to .env and adjust as needed.

# SQLite by default - zero config. Point this at a Postgres URL in production,
# e.g. postgresql+psycopg2://user:password@localhost:5432/attendance
DATABASE_URL=sqlite:///./attendance.db

# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Face recognition matching threshold (cosine similarity, 0-1). Lower = stricter.
FACE_MATCH_THRESHOLD=0.62

# Attendance is marked "late" if the person's first check-in is after this time (24h HH:MM)
LATE_CUTOFF_TIME=09:15

# Bootstrap admin account created by seed.py
ADMIN_EMAIL=admin@attendance.io
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Admin

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
