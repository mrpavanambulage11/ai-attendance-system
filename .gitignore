# Env files (docker-compose reads a root .env for JWT_SECRET_KEY / ADMIN_* overrides - never commit it)
.env
.env.*
!.env.example

# Python / backend
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc
backend/.pytest_cache/
backend/attendance.db
backend/storage/faces/*
!backend/storage/faces/.gitkeep

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local tooling state
.claude/
