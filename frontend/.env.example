# Copy to .env.local for a local override, or set in Vercel's project env vars for prod.
#
# Backend API base URL. Leave unset for local dev - Vite's dev-server proxy (vite.config.ts)
# already forwards /auth, /employees, /attendance to http://localhost:8000, so requests just
# need to stay relative. Set this when frontend and backend are deployed on different domains
# (e.g. Vercel + Render), to the backend's public URL:
#   VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
